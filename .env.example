# Example environment configuration.
#
# Every variable below has a working default (see the table in README.md), so a
# fresh clone runs with no .env at all. Copy this file only when you need to
# change something:
#
#   cp .env.example .env
#
# How these are consumed:
#   * The API (apps/api) reads them straight from the process environment — it
#     has no dotenv loader — so export them in your shell / CI, or prefix the
#     command:  DATABASE_URL=demo.db pnpm --filter @repo/api db:reset
#   * The mobile app (apps/mobile) is bundled by Expo, which auto-loads
#     `apps/mobile/.env`. Put EXPO_PUBLIC_API_URL there, not in the root .env.
#
# .env files are gitignored; this example is the committed reference.

# --- API (apps/api) -------------------------------------------------------

# Port the NestJS API listens on. Keep in sync with API_PORT in
# apps/mobile/src/api/config.ts if you change it.
PORT=3000

# SQLite file path, relative to apps/api. Honoured by the app and by the
# db:migrate / db:seed / db:reset scripts (ADR-0004).
DATABASE_URL=library.db

# HMAC secret used to sign JWTs (ADR-0005). The default is a fixed development
# value; a real deployment must set a long random secret here.
JWT_SECRET=dev-secret-change-me

# --- Mobile (apps/mobile/.env) --------------------------------------------

# Overrides the API base URL that is otherwise auto-detected from the Expo dev
# server's LAN host (ADR-0010). Set it for an Android emulator, a tunnel, or a
# non-default host/port. Baked into the bundle at build time.
#
# Android emulator:  http://10.0.2.2:3000
# Explicit LAN IP:   http://192.168.1.23:3000
# expo --tunnel:     https://<your-tunnel-host>
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
